---
// Graphite field: «20 000 км» as the one graphic figure of the page, then the repair units as future pages.
import FutureLink from "./FutureLink.astro";
import { units, mainPhone, futureNote } from "../data/site";
const marks = Array.from({ length: 21 }, (_, i) => i);
---
<section id="repair" class="section repair field-dark" aria-labelledby="repair-title">
  <div class="container repair__grid">
    <h2 id="repair-title" class="h2 repair__title">Ремонт і ТО іномарок понад 45 марок</h2>

    <div class="repair__figure">
      <p class="figure">
        <span class="figure__num num">20&nbsp;000</span>
        <span class="figure__unit">км</span>
      </p>
      <svg class="ruler" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <line x1="0" y1="23" x2="400" y2="23" stroke="currentColor" stroke-width="2" />
        {marks.map((m) => <line x1={m * 20} x2={m * 20} y1={m % 10 === 0 ? 0 : m % 5 === 0 ? 8 : 14} y2="23" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />)}
      </svg>
      <p class="figure__caption">або 6&nbsp;місяців: гарантія на всі види робіт</p>
    </div>

    <div class="repair__units">
      <h3 class="repair__sub">Що ремонтуємо й обслуговуємо</h3>
      <ul class="units" role="list">
        {units.map((u) => <li><FutureLink note={futureNote}>{u}</FutureLink></li>)}
      </ul>
      <a class="btn btn--light" href={`tel:${mainPhone.tel}`}>Подзвонити</a>
    </div>
  </div>
</section>

<style>
  .repair__grid { display: grid; gap: var(--space-6); }
  .repair__title { color: var(--color-on-dark); }
  .figure { margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  .figure__num { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-figure); line-height: .85; letter-spacing: -0.02em; white-space: nowrap; }
  .figure__unit { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h2); line-height: 1; }
  .ruler { width: 100%; height: 24px; margin-top: var(--space-5); color: var(--color-on-dark-muted); }
  .figure__caption { margin: var(--space-4) 0 0; font-size: var(--fs-lead); line-height: 1.35; color: var(--color-on-dark); max-width: 30ch; }
  .repair__units { display: grid; gap: var(--space-5); justify-items: start; }
  .repair__sub { font-family: var(--font-body); font-weight: 600; font-size: var(--fs-body); letter-spacing: 0; color: var(--color-on-dark-muted); }
  .units { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: 0 var(--gutter); width: 100%; margin: 0; padding: 0; list-style: none; }
  .units li { border-bottom: 1px solid var(--color-dark-line); }
  .units :global(.future-link) { display: flex; min-height: var(--tap); padding-block: var(--space-2); font-size: var(--fs-lead); line-height: 1.2; }
  @media (min-width: 64em) {
    .repair__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--space-7); }
    .repair__title { grid-column: 1 / span 8; }
    .repair__title { grid-row: 1; align-self: end; }
    .repair__figure { grid-column: 1 / -1; }
    .figure__caption { max-width: none; font-size: var(--fs-h3); }
    .repair__units { grid-column: 1 / -1; }
    .units { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
