---
// Crimson field: parts as a selection service by phone, no shop imitation. R-UX-4.
import FutureLink from "./FutureLink.astro";
import { mainPhone, futureNote } from "../data/site";
const facts = [
  "Безкоштовна консультація й підбір",
  "Знижки постійним клієнтам і при встановленні на СТО",
  "Не продаємо неякісні китайські запчастини",
  "Масла: моторні, трансмісійні, оригінальні",
];
---
<section id="parts" class="section parts field-accent" data-rec="R-UX-4" aria-labelledby="parts-title">
  <div class="container parts__grid">
    <h2 id="parts-title" class="h2">Запчастини підбираємо за телефоном</h2>

    <blockquote class="parts__quote">
      <p>«Ми продаємо та встановлюємо лише перевірені реальністю наших доріг автозапчастини!»</p>
    </blockquote>

    <div class="parts__price">
      <p class="price"><span class="price__from">від</span> <span class="price__num num">50</span> <span class="price__cur">грн</span></p>
      <p class="parts__brands">Для іномарок понад 45 марок: європейських, японських, корейських, американських</p>
    </div>

    <div class="parts__body">
      <ul class="facts" role="list">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
      <p class="parts__delivery">Доставка по Україні, умови за телефоном.</p>
      <div class="parts__cta">
        <a class="btn btn--light" href={`tel:${mainPhone.tel}`}>Подзвонити для підбору</a>
        <FutureLink note={futureNote}>Каталог запчастин</FutureLink>
        <FutureLink note={futureNote}>Масла</FutureLink>
      </div>
    </div>
  </div>
</section>

<style>
  .parts__grid { display: grid; gap: var(--space-6); }
  .parts__quote { margin: 0; }
  .parts__quote p { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h3); line-height: 1.1; max-width: 28ch; }
  .price { margin: 0; display: flex; align-items: baseline; gap: var(--space-3); font-family: var(--font-display); font-weight: 800; line-height: .85; }
  .price__num { font-variant-numeric: tabular-nums; font-size: clamp(5rem, 2rem + 10vw, 10rem); letter-spacing: -0.02em; }
  .price__from, .price__cur { font-size: var(--fs-h3); }
  .parts__brands { margin: var(--space-4) 0 0; color: var(--color-on-accent-muted); max-width: 34ch; }
  .facts { margin: 0; padding: 0; list-style: none; display: grid; }
  .facts li { padding: var(--space-3) 0; border-top: 1px solid var(--color-on-accent-muted); font-size: var(--fs-lead); line-height: 1.3; }
  .parts__delivery { margin: var(--space-4) 0 0; color: var(--color-on-accent-muted); }
  .parts__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-5); margin-top: var(--space-6); }
  .parts__cta .btn--light:hover { color: var(--color-accent); }
  @media (min-width: 64em) {
    .parts__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--space-7); }
    .parts__grid > h2 { grid-column: 1 / span 7; text-wrap: balance; }
    .parts__quote { grid-column: 1 / span 7; }
    .parts__price { grid-column: 9 / span 4; grid-row: 1 / span 2; align-self: end; }
    .parts__body { grid-column: 1 / span 8; }
  }
</style>
